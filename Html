<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<title>QR Kilit</title>
<script src="https://unpkg.com/html5-qrcode"></script>
<style>
body {
  font-family: Arial;
  text-align: center;
  margin-top: 40px;
}
#sifre {
  font-size: 40px;
  color: green;
}
button {
  font-size: 18px;
  padding: 10px;
}
</style>
</head>

<body>

<h2>QR Kilit Sistemi</h2>

<button onclick="yetkilendir()">Bu Cihazı Yetkilendir</button>
<br><br>

<div id="reader" style="width:300px;margin:auto;"></div>

<h3 id="sonuc"></h3>
<div id="sifre"></div>

<script>
const gizliAnahtar = 1234; // Arduino ile AYNI

function yetkilendir() {
  localStorage.setItem("yetkili", "true");
  alert("Bu cihaz yetkilendirildi");
}

function sifreUret() {
  const zamanBlogu = Math.floor(Date.now() / 1000 / 30);
  return (zamanBlogu + gizliAnahtar) % 10000;
}

function onScanSuccess(decodedText) {
  if (decodedText !== "LOCK_QR_01") return;

  if (localStorage.getItem("yetkili") !== "true") {
    document.getElementById("sonuc").innerText = "❌ Yetkisiz cihaz";
    return;
  }

  const sifre = sifreUret();
  document.getElementById("sonuc").innerText =
    "✅ Şifre (30 sn geçerli):";
  document.getElementById("sifre").innerText =
    sifre.toString().padStart(4, "0");
}

new Html5Qrcode("reader").start(
  { facingMode: "environment" },
  { fps: 10, qrbox: 250 },
  onScanSuccess
);
</script>

</body>
</html>
